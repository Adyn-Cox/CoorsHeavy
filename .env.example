# Copy to .env for local dev (or set these in your shell). In production, set
# them as Fly secrets (see README). The .env file is gitignored.

# HTTP port (Fly injects this in prod; 8080 locally)
PORT=8080

# development | production  (production enables Secure cookies for HTTPS)
ENV=development

# Where the SQLite file lives. Locally a relative path is fine.
DB_PATH=coorsheavy.db

# The single admin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Signs the login cookie. Generate a real one with: openssl rand -hex 32
SESSION_SECRET=dev-insecure-secret-change-me

# Spotify integration (optional — leave all blank to disable song assignment and playlist sync).
# 1. Create an app at https://developer.spotify.com and copy its Client ID + Secret.
# 2. Add https://coorsheavy.fly.dev/spotify/callback as a Redirect URI in the app settings.
# 3. Log in as admin and visit /spotify/auth to do the one-time OAuth flow.
# 4. Copy the displayed refresh token and run: fly secrets set SPOTIFY_REFRESH_TOKEN=<value>
# 5. Find your playlist ID from the playlist URL: open.spotify.com/playlist/<PLAYLIST_ID>
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_PLAYLIST_ID=
SPOTIFY_REDIRECT_URI=http://[::1]:8080/spotify/callback
