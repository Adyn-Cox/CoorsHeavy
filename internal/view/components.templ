package view

import (
	"github.com/Adyn-Cox/CoorsHeavy/internal/auth"
	"github.com/Adyn-Cox/CoorsHeavy/internal/spotify"
	"github.com/Adyn-Cox/CoorsHeavy/internal/store"
)

// PlayerRow is one row in the lineup. The hidden "item" input carries the
// player ID so a drag-reorder POSTs the IDs in their new order. Admins see a
// drag handle, a position dropdown, and a clickable attendance badge; the public
// sees the same data read-only — with Bench/Absent hidden.
templ PlayerRow(idx int, pws store.PlayerWithSongs, spotifyEnabled bool) {
	<div
		id={ "player-" + itoa(pws.ID) }
		class="border border-white bg-black px-3 py-2"
	>
		<div class="flex items-center gap-3">
			if auth.IsAdmin(ctx) {
				if idx >= 0 {
					<span class="drag-handle cursor-move select-none text-lg leading-none" title="Drag to reorder">⠿</span>
				} else {
					<span class="w-5"></span>
				}
			}
			if idx >= 0 {
				<input type="hidden" name="item" value={ itoa(pws.ID) }/>
				<span class="w-6 text-right font-mono text-sm">{ itoa(int64(idx + 1)) }</span>
			} else {
				<span class="w-6"></span>
			}
			@PlayerName(pws.RosterPlayer)
			if auth.IsAdmin(ctx) {
				<select
					name={ "pos_" + itoa(pws.ID) }
					class="border border-coors-red bg-black px-2 py-1 text-sm text-white"
				>
					for _, pos := range store.Positions {
						<option value={ pos } selected?={ pos == pws.Position }>{ displayPosition(pos) }</option>
					}
				</select>
			} else {
				<span class="border border-coors-red bg-black px-2 py-1 text-center text-sm font-mono text-white">{ displayPosition(pws.Position) }</span>
			}
			@AttendanceBadge(pws.RosterPlayer)
		</div>
		<div class="mt-2 space-y-1 pl-5">
			@SongSlot(pws.ID, 1, pws.Song1)
			@SongSlot(pws.ID, 2, pws.Song2)
		</div>
	</div>
}

// AttendanceBadge shows Here/Absent. For admins it is a button that toggles
// attendance and swaps itself with the updated badge. The public only ever sees
// "Here" (Absent is hidden from public view).
templ AttendanceBadge(p store.RosterPlayer) {
	if auth.IsAdmin(ctx) {
		<button
			id={ "att-" + itoa(p.ID) }
			hx-post={ "/players/" + itoa(p.ID) + "/attendance" }
			hx-swap="outerHTML"
			class={ attBadgeClass(p.Attended) + " cursor-pointer" }
		>
			{ attLabel(p.Attended) }
		</button>
	} else if p.Attended {
		<span id={ "att-" + itoa(p.ID) } class={ attBadgeClass(true) }>{ attLabel(true) }</span>
	}
}

// BeerRow is one player's beer progress bar (racks out of 2). Admins get a
// dropdown to set the amount, which swaps the whole row with the updated bar.
templ BeerRow(seasonID int64, p store.RosterPlayer) {
	<div id={ "beer-" + itoa(p.ID) } class="border border-white bg-black p-3">
		<div class="mb-1 flex items-baseline justify-between">
			<span class="font-semibold">{ p.Name }</span>
			<span class="font-mono text-sm">{ racksLabel(p.BeerRacks) } / 2 racks</span>
		</div>
		<div class="h-5 w-full border border-white bg-black">
			<div class="h-full bg-coors-red" style={ barWidth(p.BeerRacks) }></div>
		</div>
		if auth.IsAdmin(ctx) {
			<div class="mt-2 flex items-center gap-2 text-sm">
				<label class="uppercase tracking-wide">Racks:</label>
				<select
					name="racks"
					hx-post={ "/players/" + itoa(p.ID) + "/beer?season=" + store.Itoa(seasonID) }
					hx-target={ "#beer-" + itoa(p.ID) }
					hx-swap="outerHTML"
					class="border border-white bg-black px-2 py-1 text-white"
				>
					for _, v := range rackOptions() {
						<option value={ racksLabel(v) } selected?={ v == p.BeerRacks }>{ racksLabel(v) }</option>
					}
				</select>
			</div>
		}
	</div>
}

// GameRow is one row of the schedule table. Playoff games show a badge and,
// for admins, swap the time and matchup cells for dropdowns — seeding isn't
// known in advance, so the start time (6/7/8 PM) and opponent are editable.
// Each <select> posts on change and swaps this whole row back in.
templ GameRow(g store.Game, opponents []string) {
	<tr id={ "game-" + itoa(g.ID) }>
		<td class="border border-white px-3 py-2 whitespace-nowrap">
			<a href={ boxScoreLink(g) } class="underline decoration-gray-600 underline-offset-4 hover:decoration-white" title="Box score">
				{ g.Label() }
			</a>
			if g.Playoff {
				<span class="ml-2 border border-white px-1 py-0.5 text-[10px] font-bold uppercase tracking-wide">Playoff</span>
			}
		</td>
		<td class="border border-white px-3 py-2 whitespace-nowrap">
			if g.Playoff && auth.IsAdmin(ctx) {
				<select
					name="time"
					hx-post={ "/games/" + itoa(g.ID) + "/matchup" }
					hx-target={ "#game-" + itoa(g.ID) }
					hx-swap="outerHTML"
					class="border border-white bg-black px-1 py-0.5 text-white"
					aria-label="Start time"
				>
					for _, t := range store.GameTimes {
						<option value={ t } selected?={ t == g.Time }>{ t }</option>
					}
				</select>
			} else {
				{ g.Time }
			}
		</td>
		<td class="border border-white px-3 py-2 font-semibold">
			if g.Playoff && auth.IsAdmin(ctx) {
				// The matchup is the control here, so the date is the way into
				// the box score for a playoff game an admin is still seeding.
				<span class="mr-1">{ homeAway(g) }</span>
				<select
					name="opponent"
					hx-post={ "/games/" + itoa(g.ID) + "/matchup" }
					hx-target={ "#game-" + itoa(g.ID) }
					hx-swap="outerHTML"
					class="border border-white bg-black px-1 py-0.5 text-white"
					aria-label="Opponent"
				>
					<option value={ store.TBDOpponent } selected?={ g.Opponent == store.TBDOpponent }>{ store.TBDOpponent }</option>
					for _, o := range opponents {
						<option value={ o } selected?={ o == g.Opponent }>{ o }</option>
					}
				</select>
			} else {
				<a href={ boxScoreLink(g) } class="underline decoration-gray-600 underline-offset-4 hover:decoration-white" title="Box score">
					{ matchup(g) }
				</a>
			}
		</td>
		@ScoreCell(g)
	</tr>
}

// ScoreCell is the schedule table's result cell. Admins get an inline editor
// (our score vs theirs, Save, and Clear once played); the public sees the result.
templ ScoreCell(g store.Game) {
	<td id={ "score-" + itoa(g.ID) } class="border border-white px-3 py-2 whitespace-nowrap">
		if auth.IsAdmin(ctx) {
			<form
				hx-post={ "/games/" + itoa(g.ID) + "/score" }
				hx-target={ "#score-" + itoa(g.ID) }
				hx-swap="outerHTML"
				class="flex items-center gap-1"
			>
				<input
					type="number"
					name="us"
					value={ scoreVal(g, true) }
					placeholder="us"
					class="w-12 border border-white bg-black px-1 py-0.5 text-center text-white"
					aria-label="Coors Heavy score"
				/>
				<span>-</span>
				<input
					type="number"
					name="them"
					value={ scoreVal(g, false) }
					placeholder="opp"
					class="w-12 border border-white bg-black px-1 py-0.5 text-center text-white"
					aria-label="Opponent score"
				/>
				<button type="submit" class="border border-white bg-white px-2 py-0.5 text-xs uppercase text-black hover:bg-black hover:text-white">
					Save
				</button>
				if g.Played {
					<span class="ml-1 font-bold">{ g.Result() }</span>
					<button type="submit" name="clear" value="1" class="ml-1 border border-white px-2 py-0.5 text-xs uppercase hover:bg-white hover:text-black">
						Clear
					</button>
				}
			</form>
		} else {
			if g.Played {
				<span class="font-bold">{ g.Result() }</span>
			} else {
				<span class="text-gray-400">—</span>
			}
		}
	</td>
}

// DonatedBadge shows whether a donation was made; clickable toggle for admins.
templ DonatedBadge(d store.Donation) {
	if auth.IsAdmin(ctx) {
		<button
			id={ "donated-" + itoa(d.ID) }
			hx-post={ "/donations/" + itoa(d.ID) + "/toggle" }
			hx-swap="outerHTML"
			class={ badgeClass(d.Donated) + " cursor-pointer" }
		>
			{ donatedLabel(d.Donated) }
		</button>
	} else {
		<span id={ "donated-" + itoa(d.ID) } class={ badgeClass(d.Donated) }>{ donatedLabel(d.Donated) }</span>
	}
}

// DonationRow is a single donation entry; admins can toggle it or remove it.
templ DonationRow(d store.Donation) {
	<div id={ "donation-" + itoa(d.ID) } class="flex items-center justify-between gap-3 border border-white bg-black px-3 py-2">
		<div class="min-w-0">
			<div class="font-semibold">{ d.Name }</div>
			if d.Description != "" {
				<div class="text-sm text-gray-400">{ d.Description }</div>
			}
		</div>
		<div class="flex shrink-0 items-center gap-2">
			@DonatedBadge(d)
			if auth.IsAdmin(ctx) {
				<button
					hx-post={ "/donations/" + itoa(d.ID) + "/delete" }
					hx-target={ "#donation-" + itoa(d.ID) }
					hx-swap="outerHTML"
					class="border border-white px-2 py-1 text-xs uppercase hover:bg-white hover:text-black"
				>
					Remove
				</button>
			}
		</div>
	</div>
}

// SongSlot renders one walk-up song slot. Shows a button that opens the search
// modal. The outer div is the HTMX outerHTML swap target.
templ SongSlot(playerID int64, slot int, song *store.PlayerSong) {
	<div id={ "song-slot-" + itoa(playerID) + "-" + slotStr(slot) } class="flex items-center gap-2 text-sm">
		<span class="text-xs font-semibold uppercase tracking-wide text-gray-500 w-12 shrink-0">{ slotLabel(slot) }:</span>
		if song != nil {
			<span class="flex-1 text-gray-200">{ song.TrackName } — { song.ArtistName }</span>
			<button
				type="button"
				hx-get={ "/songs/search-modal?player_id=" + itoa(playerID) + "&slot=" + slotStr(slot) }
				hx-target="#song-modal-inner"
				hx-swap="innerHTML"
				hx-on::after-request="openSongModal()"
				class="text-xs text-gray-500 hover:text-white uppercase tracking-wide"
			>Change</button>
			<button
				type="button"
				hx-delete={ "/players/" + itoa(playerID) + "/songs/" + slotStr(slot) }
				hx-target={ "#song-slot-" + itoa(playerID) + "-" + slotStr(slot) }
				hx-swap="outerHTML"
				class="text-xs text-gray-500 hover:text-white"
			>✕</button>
		} else {
			<button
				type="button"
				hx-get={ "/songs/search-modal?player_id=" + itoa(playerID) + "&slot=" + slotStr(slot) }
				hx-target="#song-modal-inner"
				hx-swap="innerHTML"
				hx-on::after-request="openSongModal()"
				class="text-xs text-gray-400 hover:text-white border border-gray-600 hover:border-white px-2 py-0.5 uppercase tracking-wide"
			>+ Add</button>
		}
	</div>
}

// SongSearchModal is the content rendered inside the song search modal.
templ SongSearchModal(playerName string, playerID int64, slot int) {
	<div>
		<div class="mb-4 flex items-center justify-between">
			<h2 class="font-bold uppercase tracking-wide">{ slotLabel(slot) } — { playerName }</h2>
			<button type="button" onclick="closeSongModal()" class="text-gray-400 hover:text-white text-xl leading-none">✕</button>
		</div>
		<input
			type="text"
			name="q"
			placeholder="Search Spotify…"
			autocomplete="off"
			autofocus
			hx-get={ "/search/tracks?player_id=" + itoa(playerID) + "&slot=" + slotStr(slot) }
			hx-trigger="keyup changed delay:300ms"
			hx-target="#modal-results"
			class="w-full border border-white bg-black px-3 py-2 text-white placeholder-gray-500 focus:outline-none"
		/>
		<div id="modal-results" class="mt-1 max-h-64 overflow-y-auto"></div>
	</div>
}

// TrackSearchResults is the HTMX fragment returned by GET /search/tracks.
// Rendered inside the song search modal — no absolute positioning needed.
templ TrackSearchResults(tracks []spotify.Track, playerID int64, slot int) {
	for _, t := range tracks {
		<button
			type="button"
			hx-post={ "/players/" + itoa(playerID) + "/songs/" + slotStr(slot) }
			hx-vals={ trackValsJSON(t.ID, t.Name, t.ArtistName) }
			hx-target={ "#song-slot-" + itoa(playerID) + "-" + slotStr(slot) }
			hx-swap="outerHTML"
			hx-on::after-request="if(!event.detail.failed)closeSongModal()"
			class="block w-full border-b border-gray-800 px-3 py-3 text-left hover:bg-white hover:text-black"
		>
			<div class="font-semibold">{ t.Name }</div>
			<div class="text-sm text-gray-400">{ t.ArtistName }</div>
		</button>
	}
}

// SyncResult is swapped into the sync status area after a playlist sync attempt.
templ SyncResult(ok bool, count int, errMsg string) {
	<span id="sync-result" class="text-sm">
		if ok {
			<span class="text-green-400">✓ Synced { slotStr(count) } tracks to Spotify</span>
		} else if errMsg != "" {
			<span class="text-red-400">✗ { errMsg }</span>
		}
	</span>
}

// AddDonationForm lets the admin add a new donation; the new row is appended.
templ AddDonationForm() {
	<form
		hx-post="/donations"
		hx-target="#donations"
		hx-swap="beforeend"
		hx-on::after-request="this.reset()"
		class="mb-4 flex flex-wrap items-center gap-2 border border-white bg-black p-3"
	>
		<input
			type="text"
			name="name"
			required
			placeholder="Who"
			class="flex-1 border border-white bg-black px-2 py-1 text-white"
		/>
		<input
			type="text"
			name="description"
			placeholder="What they donated"
			class="flex-1 border border-white bg-black px-2 py-1 text-white"
		/>
		<label class="flex items-center gap-1 text-sm uppercase tracking-wide">
			<input type="checkbox" name="donated" value="true"/> Donated
		</label>
		<button type="submit" class="border border-white bg-white px-3 py-1 font-semibold text-black hover:bg-black hover:text-white">
			Add
		</button>
	</form>
}

// SeasonSwitcher is the season dropdown shown above season-scoped pages. It
// renders nothing until there is more than one season to switch between.
templ SeasonSwitcher(current store.Season, seasons []store.Season, basePath string) {
	if len(seasons) > 1 {
		<form method="get" action={ templ.SafeURL(basePath) } class="mb-4 flex items-center gap-2">
			<label for="season-select" class="text-xs font-semibold uppercase tracking-widest text-gray-500">Season</label>
			<select
				id="season-select"
				name="season"
				onchange="this.form.submit()"
				class="border border-white bg-black px-2 py-1 text-sm text-white"
			>
				for _, s := range seasons {
					<option value={ store.Itoa(s.ID) } selected?={ s.ID == current.ID }>
						{ s.Name }
						if s.IsCurrent {
							{ " (current)" }
						}
					</option>
				}
			</select>
			<noscript><button type="submit" class="border border-white px-2 py-1 text-sm">Go</button></noscript>
		</form>
	}
}

// GamePicker scopes the stats table to one game. The empty option drops the
// parameter entirely rather than encoding "all" as a magic id, so the season
// leaderboard stays the plain /stats URL people share.
templ GamePicker(season store.Season, games []store.Game, sel *store.Game) {
	if len(games) > 0 {
		<form method="get" action="/stats" class="mb-4 flex flex-wrap items-center gap-2">
			<input type="hidden" name="season" value={ store.Itoa(season.ID) }/>
			<label for="game-select" class="text-xs font-semibold uppercase tracking-widest text-gray-500">Game</label>
			<select
				id="game-select"
				name="game"
				onchange="this.form.submit()"
				class="border border-white bg-black px-2 py-1 text-sm text-white"
			>
				<option value="" selected?={ sel == nil }>Season totals</option>
				for _, g := range games {
					<option value={ itoa(g.ID) } selected?={ sel != nil && sel.ID == g.ID }>{ gameOption(g) }</option>
				}
			</select>
			<noscript><button type="submit" class="border border-white px-2 py-1 text-sm">Go</button></noscript>
			if sel != nil {
				<a
					href={ templ.SafeURL("/stats?season=" + store.Itoa(season.ID)) }
					class="text-xs font-semibold uppercase tracking-widest text-gray-500 hover:text-white hover:underline"
				>Season totals</a>
			}
		</form>
	}
}

// StatRow is one player's season line, built from the shared column
// definitions so it can never drift out of step with the header. Players short
// of the qualifying at-bat count are marked rather than hidden — a beer league
// wants to see everyone, it just shouldn't crown a batting champ off four AB.
// The table context carries the column leaders (marked red) and whether this is
// a season table. A box score isn't: a qualifying at-bat count is a season-long
// idea, and starring every player on a single night says nothing.
templ StatRow(row store.PlayerBatting, t statTable) {
	<tr class={ rowClass(row) }>
		for i, c := range statColumns() {
			<td data-group={ c.Group } class={ cellClass(c, row, t.leads(c, row)) }>
				if i == 0 && !isTeamTotals(row) {
					<a href={ templ.SafeURL("/stats/" + row.Slug) } class="hover:underline">{ row.Name }</a>
					if t.Season && !qualified(row.Batting) {
						<span class="ml-1 text-xs text-gray-600" title="Not enough at-bats to qualify for rate leaders">*</span>
					}
				} else {
					{ cellText(c, row) }
				}
			</td>
		}
	</tr>
}

// PlayerName is the lineup's name cell. Admins get an inline editor — the seed
// roster contains two Patty and two Parker, and until they are told apart four
// players are ambiguous on the stat sheet and in any name-keyed CSV.
//
// The slug is shown while editing because it, not the name, is what the stats
// CSV keys on: renaming here is cosmetic and won't break lines already typed.
templ PlayerName(p store.RosterPlayer) {
	<span id={ "name-" + itoa(p.ID) } class="flex-1">
		if auth.IsAdmin(ctx) {
			<form
				hx-post={ "/players/" + itoa(p.ID) + "/name" }
				hx-target={ "#name-" + itoa(p.ID) }
				hx-swap="outerHTML"
				class="flex items-center gap-1"
			>
				<input
					type="text"
					name="name"
					value={ p.Name }
					aria-label={ "Name for " + p.Slug }
					class="w-28 border border-transparent bg-black px-1 py-0.5 font-semibold text-white hover:border-gray-600 focus:border-white focus:outline-none"
				/>
				<button type="submit" class="border border-white px-1 py-0.5 text-[10px] uppercase hover:bg-white hover:text-black">Save</button>
				<span class="font-mono text-[10px] text-gray-600">{ p.Slug }</span>
			</form>
		} else {
			<span class="font-semibold">{ p.Name }</span>
		}
	</span>
}

// AddPlayerForm adds someone to the current season's roster. New players land
// in the Absent section un-numbered: they're on the team, but not in tonight's
// batting order until an admin says so.
templ AddPlayerForm() {
	<form
		hx-post="/players"
		hx-target="#absent-list"
		hx-swap="beforeend"
		hx-on::after-request="if(event.detail.successful) this.reset()"
		class="mt-4 flex flex-wrap items-center gap-2 border border-gray-700 p-3"
	>
		<label for="new-player" class="text-xs font-semibold uppercase tracking-widest text-gray-500">Add player</label>
		<input
			id="new-player"
			type="text"
			name="name"
			required
			placeholder="Name"
			class="border border-white bg-black px-2 py-1 text-white"
		/>
		<button type="submit" class="border border-white px-3 py-1 text-xs font-bold uppercase tracking-wide hover:bg-white hover:text-black">
			Add
		</button>
	</form>
}
