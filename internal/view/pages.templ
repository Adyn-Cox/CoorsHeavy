package view

import (
	"github.com/Adyn-Cox/CoorsHeavy/internal/auth"
	"github.com/Adyn-Cox/CoorsHeavy/internal/store"
)

// Home is the landing page: logo + quick links to the three sections.
templ Home() {
	@Layout("Home") {
		<div class="text-center">
			<img
				src="/static/logo.svg"
				alt="Coors Heavy softball"
				class="mx-auto mb-6 h-40 w-40 object-contain"
			/>
			<h1 class="mb-2 text-4xl font-black uppercase tracking-widest">Coors Heavy</h1>
			<p class="mb-8 text-gray-400">Team lineup, schedule, stats, and beer tracker.</p>
		</div>
		<div class="grid gap-4 sm:grid-cols-2">
			@homeCard("Lineup", "Set the batting order, positions, and who showed up.", "/lineup")
			@homeCard("Schedule", "Upcoming and past games, every season.", "/schedule")
			@homeCard("Stats", "Batting lines, averages, and career totals.", "/stats")
			@homeCard("Beer", "Who brought their racks — and who donated.", "/beer")
		</div>
	}
}

templ homeCard(title, desc, href string) {
	<a href={ templ.SafeURL(href) } class="block border-2 border-white p-6 transition hover:bg-white hover:text-black">
		<div class="mb-1 text-xl font-bold uppercase tracking-wide">{ title }</div>
		<div class="text-sm">{ desc }</div>
	</a>
}

// Lineup shows the roster split into present and absent players.
// Admins get drag-to-reorder, position dropdowns, attendance toggles, and a Save button.
// The public sees a read-only batting order with an absent section below the divider.
// When spotifyEnabled, every player row shows song search slots (public can edit).
templ Lineup(season store.Season, present, absent []store.PlayerWithSongs, spotifyEnabled bool) {
	@Layout("Lineup") {
		<h1 class="mb-2 text-3xl font-black uppercase tracking-widest">Lineup</h1>
		if auth.IsAdmin(ctx) {
			<p class="mb-4 text-sm text-gray-400">Drag ⠿ to set batting order. Set positions and attendance, then click Save Lineup.</p>
			<form id="lineup-form" method="post" action={ templ.SafeURL("/lineup/save?season=" + store.Itoa(season.ID)) }>
				<div class="sortable space-y-2">
					for i, pws := range present {
						@PlayerRow(season.ID, i, pws, spotifyEnabled)
					}
				</div>
				<div class="my-5 flex items-center gap-3">
					<div class="h-px flex-1 bg-white opacity-30"></div>
					<span class="text-xs font-semibold uppercase tracking-widest text-gray-500">Absent</span>
					<div class="h-px flex-1 bg-white opacity-30"></div>
				</div>
				<div id="absent-list" class="space-y-2 opacity-50">
					for _, pws := range absent {
						@PlayerRow(season.ID, -1, pws, spotifyEnabled)
					}
				</div>
				<div class="mt-6 flex flex-wrap items-center gap-4">
					<button type="submit" class="border border-white bg-white px-6 py-2 font-bold uppercase tracking-wide text-black hover:bg-black hover:text-white">
						Save Lineup
					</button>
					if spotifyEnabled {
						<button
							type="button"
							hx-post="/playlist/sync"
							hx-target="#sync-result"
							hx-swap="outerHTML"
							class="border border-white px-6 py-2 font-bold uppercase tracking-wide hover:bg-white hover:text-black"
						>Sync Playlist</button>
						@SyncResult(false, 0, "")
					}
				</div>
			</form>
			@AddPlayerForm(season.ID)
		} else {
			<div class="space-y-2">
				for i, pws := range present {
					@PlayerRow(season.ID, i, pws, spotifyEnabled)
				}
			</div>
			if len(absent) > 0 {
				<div class="my-5 flex items-center gap-3">
					<div class="h-px flex-1 bg-white opacity-30"></div>
					<span class="text-xs font-semibold uppercase tracking-widest text-gray-500">Absent</span>
					<div class="h-px flex-1 bg-white opacity-30"></div>
				</div>
				<div class="space-y-2 opacity-50">
					for _, pws := range absent {
						@PlayerRow(season.ID, -1, pws, spotifyEnabled)
					}
				</div>
			}
		}
	}
}

// Schedule lists one season's games. opponents is the pick-list for playoff
// matchups (see GameRow). The league, location and footnotes come from the
// season row rather than being hardcoded, so every season reads correctly.
templ Schedule(season store.Season, games []store.Game, opponents []string) {
	@Layout("Schedule") {
		<h1 class="mb-1 text-3xl font-black uppercase tracking-widest">Schedule</h1>
		<p class="mb-4 text-sm text-gray-400">
			Coors Heavy · { season.Name }
			if season.League != "" {
				{ " · " + season.League }
			}
			if season.Location != "" {
				{ " · " + season.Location }
			}
		</p>
		if len(games) == 0 {
			<p class="text-gray-400">
				No games yet for { season.Name }. Load them with
				<code>go run ./cmd/import-schedule -season { store.Itoa(season.ID) }</code>.
			</p>
		} else {
			<p class="mb-3 text-sm font-semibold uppercase tracking-widest">Record: { recordLabel(games) }</p>
			<div class="overflow-x-auto">
				<table class="w-full border-collapse border border-white text-left">
					<thead>
						<tr class="bg-white text-black">
							<th class="border border-white px-3 py-2">Date</th>
							<th class="border border-white px-3 py-2">Time</th>
							<th class="border border-white px-3 py-2">Matchup</th>
							<th class="border border-white px-3 py-2">Result</th>
						</tr>
					</thead>
					<tbody>
						for _, g := range games {
							@GameRow(g, opponents)
						}
					</tbody>
				</table>
			</div>
			if len(season.NoteLines()) > 0 {
				<div class="mt-6 space-y-1 border-l-4 border-white pl-3 text-sm text-gray-400">
					for _, note := range season.NoteLines() {
						<p>{ note }</p>
					}
				</div>
			}
		}
	}
}

// Beer shows each player's progress toward 2 racks, then the donations list.
templ Beer(season store.Season, players []store.RosterPlayer, donations []store.Donation) {
	@Layout("Beer") {
		<h1 class="mb-2 text-3xl font-black uppercase tracking-widest">Beer</h1>
		<p class="mb-4 text-sm text-gray-400">Goal: 2 thirty-racks per player · { season.Name }</p>
		<div class="grid gap-3 sm:grid-cols-2">
			for _, p := range players {
				@BeerRow(season.ID, p)
			}
		</div>

		<h2 class="mb-2 mt-10 text-2xl font-black uppercase tracking-widest">Donations</h2>
		if auth.IsAdmin(ctx) {
			@AddDonationForm()
		}
		<div id="donations" class="space-y-2">
			for _, d := range donations {
				@DonationRow(d)
			}
		</div>
		if len(donations) == 0 && !auth.IsAdmin(ctx) {
			<p class="text-gray-400">No donations recorded yet.</p>
		}
	}
}

// Login is the admin sign-in form (standard POST, not HTMX).
templ Login(errMsg string) {
	@Layout("Login") {
		<div class="mx-auto max-w-sm">
			<h1 class="mb-4 text-3xl font-black uppercase tracking-widest">Admin Login</h1>
			if errMsg != "" {
				<div class="mb-4 border-2 border-white bg-white px-3 py-2 text-sm font-semibold text-black">
					{ errMsg }
				</div>
			}
			<form method="post" action="/login" class="space-y-3">
				<div>
					<label class="block text-sm font-semibold uppercase tracking-wide">Username</label>
					<input type="text" name="username" required autofocus class="w-full border border-white bg-black px-3 py-2 text-white"/>
				</div>
				<div>
					<label class="block text-sm font-semibold uppercase tracking-wide">Password</label>
					<input type="password" name="password" required class="w-full border border-white bg-black px-3 py-2 text-white"/>
				</div>
				<button type="submit" class="w-full border border-white bg-white px-3 py-2 font-bold uppercase tracking-wide text-black hover:bg-black hover:text-white">
					Log in
				</button>
			</form>
		</div>
	}
}

// Stats is the batting table. With no game selected it totals the season; with
// one it is that game's box score, rendered by the same columns — a box score
// is a season table scoped to one night, and duplicating thirty column
// definitions to say so would guarantee the two drift apart.
//
// Every rate follows the league's stat key and is derived from the stored
// counting stats; nothing here is stored. The key defines 27 stats, far too
// wide to read at once, so columns are grouped and the view toggles between
// them.
templ Stats(season store.Season, seasons []store.Season, games []store.Game, sel *store.Game, allSeasons bool, rows []store.PlayerBatting, team store.Batting) {
	@Layout(statsTitle(sel, allSeasons)) {
		<h1 class="mb-1 text-3xl font-black uppercase tracking-widest">
			if sel != nil {
				Box Score
			} else {
				Stats
			}
		</h1>
		<p class="mb-4 text-sm text-gray-400">{ statsSubtitle(season, seasons, sel, allSeasons) }</p>
		@ScopePicker(season, seasons, games, sel, allSeasons)
		if len(rows) == 0 {
			<p class="text-gray-400">
				if sel != nil {
					No stats recorded for { sel.Label() } vs { sel.Opponent } yet.
				} else if allSeasons {
					No stats recorded yet.
				} else {
					No stats recorded for { season.Name } yet.
				}
				if auth.IsAdmin(ctx) {
					Type them in on the <a href={ sheetLink(season, sel) } class="underline">stat sheet</a>.
				}
			</p>
		} else {
			{{ table := newStatTable(rows, sel == nil) }}
			<div class="mb-3 flex flex-wrap items-center gap-2">
				<span class="text-xs font-semibold uppercase tracking-widest text-gray-500">Columns</span>
				for _, g := range []string{"Standard", "Advanced", "All"} {
					<button
						type="button"
						data-cols={ g }
						class="stat-toggle border border-white px-3 py-1 text-xs font-bold uppercase tracking-wide hover:bg-white hover:text-black"
					>{ g }</button>
				}
				<span class="ml-2 text-xs text-gray-500">
					Click a column to sort · hover a header for its definition ·
					<span class="stat-lead">red</span> marks the leader
					if sel == nil {
						{ " · " + store.Itoa(int64(store.MinQualifiedAB)) + " AB to qualify (*)" }
					}
				</span>
			</div>
			<div class="overflow-x-auto">
				<table id="stats-table" class="w-full border-collapse border border-white text-right text-sm">
					<thead>
						<tr class="bg-white text-black">
							for _, c := range statColumns() {
								<th
									data-sort={ c.sortKind() }
									data-group={ c.Group }
									title={ c.Help }
									class={ headerClass(c) }
								>{ c.Label }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, row := range rows {
							@StatRow(row, table)
						}
					</tbody>
					<tfoot>
						@StatRow(teamRow(team), table)
					</tfoot>
				</table>
			</div>
			<script src="/static/sorttable.js"></script>
			if auth.IsAdmin(ctx) && !allSeasons {
				<p class="mt-4 text-sm">
					<a href={ sheetLink(season, sel) } class="border border-white px-3 py-1 text-xs font-bold uppercase tracking-wide hover:bg-white hover:text-black">
						if sel != nil {
							Edit this game
						} else {
							Enter stats
						}
					</a>
				</p>
			}
		}
	}
}

// PlayerStats is one player's game log, season totals and career totals.
templ PlayerStats(p store.Player, season store.Season, seasons []store.Season, log []store.GameBatting, seasonTotal store.Batting, career store.Batting, careerGames int) {
	@Layout(p.Name) {
		<h1 class="mb-1 text-3xl font-black uppercase tracking-widest">{ p.Name }</h1>
		<p class="mb-4 text-sm text-gray-400">Game log · { season.Name }</p>
		<div class="mb-6 grid gap-3 sm:grid-cols-4">
			@statTile("Avg", rate(seasonTotal.AVG()))
			@statTile("OB%", rate(seasonTotal.OBP()))
			@statTile("Slug", rate(seasonTotal.SLG()))
			@statTile("RP7", count(seasonTotal.RP7()))
		</div>
		<h2 class="mb-2 text-xs font-semibold uppercase tracking-widest text-gray-500">
			{ season.Name } — full line
		</h2>
		<div class="mb-8 grid grid-cols-3 gap-px border border-gray-700 bg-gray-700 sm:grid-cols-5 lg:grid-cols-7">
			for _, p := range statSummary(seasonTotal, len(log)) {
				<div class="bg-black px-2 py-2 text-center" title={ p.Help }>
					<div class="text-[10px] font-semibold uppercase tracking-widest text-gray-500">{ p.Label }</div>
					<div class={ summaryValueClass(p) }>{ p.Value }</div>
				</div>
			}
		</div>
		if len(log) == 0 {
			<p class="text-gray-400">No games recorded for { p.Name } in { season.Name }.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full border-collapse border border-white text-right text-sm">
					<thead>
						<tr class="bg-white text-black">
							<th class="border border-white px-2 py-2 text-left">Date</th>
							<th class="border border-white px-2 py-2 text-left">Opponent</th>
							for _, c := range []string{"AB", "R", "H", "2B", "3B", "HR", "RBI", "BB", "SO", "SF", "E", "AVG"} {
								<th class="border border-white px-2 py-2">{ c }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, gb := range log {
							<tr class="border-b border-gray-700">
								<td class="px-2 py-1 text-left">{ gb.Label() }</td>
								<td class="px-2 py-1 text-left">{ matchup(gb.Game) }</td>
								<td class={ zeroDim(gb.AB) }>{ statCell(gb.AB) }</td>
								<td class={ zeroDim(gb.R) }>{ statCell(gb.R) }</td>
								<td class={ zeroDim(gb.H) }>{ statCell(gb.H) }</td>
								<td class={ zeroDim(gb.B2) }>{ statCell(gb.B2) }</td>
								<td class={ zeroDim(gb.B3) }>{ statCell(gb.B3) }</td>
								<td class={ zeroDim(gb.HR) }>{ statCell(gb.HR) }</td>
								<td class={ zeroDim(gb.RBI) }>{ statCell(gb.RBI) }</td>
								<td class={ zeroDim(gb.BB) }>{ statCell(gb.BB) }</td>
								<td class={ zeroDim(gb.SO) }>{ statCell(gb.SO) }</td>
								<td class={ zeroDim(gb.SF) }>{ statCell(gb.SF) }</td>
								<td class={ zeroDim(gb.E) }>{ statCell(gb.E) }</td>
								<td class="px-2 py-1 font-semibold">{ rate(gb.Batting.AVG()) }</td>
							</tr>
						}
					</tbody>
					<tfoot>
						<tr class="border-t-2 border-white font-bold">
							<td class="px-2 py-1 text-left uppercase" colspan="2">{ season.Name } total</td>
							<td class="px-2 py-1">{ statCell(seasonTotal.AB) }</td>
							<td class="px-2 py-1">{ statCell(seasonTotal.R) }</td>
							<td class="px-2 py-1">{ statCell(seasonTotal.H) }</td>
							<td class="px-2 py-1">{ statCell(seasonTotal.B2) }</td>
							<td class="px-2 py-1">{ statCell(seasonTotal.B3) }</td>
							<td class="px-2 py-1">{ statCell(seasonTotal.HR) }</td>
							<td class="px-2 py-1">{ statCell(seasonTotal.RBI) }</td>
							<td class="px-2 py-1">{ statCell(seasonTotal.BB) }</td>
							<td class="px-2 py-1">{ statCell(seasonTotal.SO) }</td>
							<td class="px-2 py-1">{ statCell(seasonTotal.SF) }</td>
							<td class="px-2 py-1">{ statCell(seasonTotal.E) }</td>
							<td class="px-2 py-1">{ rate(seasonTotal.AVG()) }</td>
						</tr>
						if len(seasons) > 1 {
							<tr class="text-gray-400">
								<td class="px-2 py-1 text-left uppercase" colspan="2">Career ({ statCell(careerGames) } G)</td>
								<td class="px-2 py-1">{ statCell(career.AB) }</td>
								<td class="px-2 py-1">{ statCell(career.R) }</td>
								<td class="px-2 py-1">{ statCell(career.H) }</td>
								<td class="px-2 py-1">{ statCell(career.B2) }</td>
								<td class="px-2 py-1">{ statCell(career.B3) }</td>
								<td class="px-2 py-1">{ statCell(career.HR) }</td>
								<td class="px-2 py-1">{ statCell(career.RBI) }</td>
								<td class="px-2 py-1">{ statCell(career.BB) }</td>
								<td class="px-2 py-1">{ statCell(career.SO) }</td>
								<td class="px-2 py-1">{ statCell(career.SF) }</td>
								<td class="px-2 py-1">{ statCell(career.E) }</td>
								<td class="px-2 py-1">{ rate(career.AVG()) }</td>
							</tr>
						}
					</tfoot>
				</table>
			</div>
		}
	}
}

templ statTile(label, value string) {
	<div class="border-2 border-white p-4 text-center">
		<div class="text-xs font-semibold uppercase tracking-widest text-gray-400">{ label }</div>
		<div class="text-2xl font-black">{ value }</div>
	</div>
}

// StatSheet is the transcription grid: pick a game, type a line per player,
// save. Admin-only.
//
// It opens on whatever is already stored for a game, so editing a night that
// has been typed is the same act as typing it the first time.
templ StatSheet(season store.Season, data any) {
	@Layout("Stat Sheet") {
		<h1 class="mb-1 text-3xl font-black uppercase tracking-widest">Stat Sheet</h1>
		<p class="mb-4 text-sm text-gray-400">
			{ season.Name } · type a line per player, then save. Work in progress is
			kept in this browser until you do.
		</p>
		@templ.JSONScript("statsheet-data", data)
		<div id="statsheet-root" class="space-y-4"></div>
		<script src="/static/statsheet.js"></script>
	}
}
